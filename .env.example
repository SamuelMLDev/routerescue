# No keys are necessary. RouteRescue always uses fictional, local demo data.
# Change if the default port is already used.
PORT=4173
# Bind to localhost for security. Remote deployment requires authentication and HTTPS.
HOST=127.0.0.1
# Optional custom location for persisted dispatch data, otherwise ./data/state.json
# ROUTERESCUE_DATA_FILE=C:\route-rescue\dispatch.json

# Optional: local coordinator login. Omit entirely for zero-setup fictional demo.
# JSON mapping usernames to >=12 character passwords. Set using your shell/environment;
# do not commit real credentials or share this file once populated.
# ROUTERESCUE_USERS_JSON={"alex":"UseALongSecretHere!","pat":"ASecondLongSecret!"}

# Optional REAL hosted AI model, read-only MCP investigation only (never approval).
# AI_API_KEY=your_secret_key
# AI_MODEL=your_supported_model_name
# AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Optional OSRM routing matrix import (no calls in demo mode).
# OSRM_BASE_URL=https://your-authorised-routing-endpoint.example
